# ─────────────────────────────────────────────────────────────
# Revenue Recovery Agent — Environment Variables
# Copy this file to .env and fill in real values.
# .env is git-ignored. This file (.env.example) is committed.
# ─────────────────────────────────────────────────────────────

# ── Groq ──────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# Groq-hosted model IDs (current as of Aug 2026)
GROQ_TIER1_MODEL=openai/gpt-oss-20b
GROQ_TIER2_MODEL=openai/gpt-oss-120b

# ── Postgres ───────────────────────────────────────────────────
# Matches docker-compose.yml defaults. Change for a remote DB.
DATABASE_URL=postgresql+asyncpg://recovery:recovery@localhost:5434/recovery_agent

# ── App ────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp (Meta Cloud API) ──────────────────────────────────
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
